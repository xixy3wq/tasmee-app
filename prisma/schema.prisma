// قاعدة بيانات منصة حلقات التسميع — PostgreSQL (Neon) على Vercel

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

/// role: admin | teacher | student — status: pending | active | disabled
model User {
  id           String    @id @default(cuid())
  role         String
  status       String    @default("active")
  name         String
  username     String    @unique
  passwordHash String
  info         Json      @default("{}")
  halqaId      String?
  reqHalqaId   String?
  canPlan      Boolean   @default(false)
  canAuto      Boolean   @default(false)
  autoAllowed  Boolean   @default(false)
  plan         Json?
  /// هدف الطالب: { pages, from, by, note }
  goal         Json?
  /// صلاحيات المدير المساعد (null = مدير كامل)
  perms        Json?
  createdAt    DateTime  @default(now())
  approvedAt   DateTime?
  /// آخر مرة فتح فيها الموقع
  lastSeenAt   DateTime?
  /// الجائزة اللي يجمع لها (سلة الأمنيات)
  wish         String?
  /// نتيجة اختبار تحديد المستوى
  level        Json?
}

model Halqa {
  id        String   @id @default(cuid())
  name      String
  teacherId String?
  days      Int[]
  time      String   @default("")
  /// رابط ثابت للحلقة يُستخدم لكل حصة ما لم يُحدد رابط خاص
  link      String   @default("")
  /// إنشاء الحصص تلقائيًا حسب أيام الدوام
  auto      Boolean  @default(false)
  /// المجمع أو الجامع (فارغ = الأساسي)
  branch    String   @default("")
  /// نوع الحلقة: onsite حضوري، remote عن بعد، hybrid هجين
  mode      String   @default("onsite")
  /// مكانها داخل الجامع (مثل: القبو)
  place     String   @default("")
  /// m رجالية، f نسائية
  gender    String   @default("m")
  createdAt DateTime @default(now())
}

/// حصة: date بصيغة YYYY-MM-DD
model Lesson {
  id        String   @id @default(cuid())
  halqaId   String
  date      String
  time      String   @default("")
  link      String   @default("")
  note      String   @default("")
  att       Json     @default("{}")
  queue     Json     @default("[]")
  currentId String?
  /// للحصص المنشأة تلقائيًا: halqaId_date
  autoKey   String?  @unique
  cancelled Boolean  @default(false)
  /// معلم احتياط لهذه الحصة
  subId     String?
  /// وقت فتح المعلم للحصة (حضور المعلم)
  teacherAt DateTime?
  teacherBy String?
  /// أُرسل تذكير الحصة
  reminded  Boolean  @default(false)
  /// أُرسل للمعلم تنبيه بمن ما دخل بعد 10 دقائق
  lateAlerted Boolean @default(false)
  /// مشاكل الدخول: { uid: { at, msg } }
  issues    Json     @default("{}")
  /// حصة تلقائية عدّل المعلم وقتها أو تاريخها يدويًا (ما تتبع جدول الحلقة بعدها)
  custom    Boolean  @default(false)
  /// نوع هذي الحصة لو تغيّر عن نوع الحلقة (تحويل بضغطة)
  mode      String   @default("")
  /// وقت وصول كل طالب { uid: ms }
  arr       Json     @default("{}")
  /// الانصراف بدري { uid: { at, reason } }
  left      Json     @default("{}")
  /// المعلم أنهى الحلقة
  closedAt  DateTime?
  createdBy String?
  createdAt DateTime @default(now())

  @@index([halqaId, date])
}

model Join {
  id       String   @id @default(cuid())
  lessonId String
  userId   String
  at       DateTime @default(now())
  leftAt   DateTime?

  @@unique([lessonId, userId])
}

/// type: new | review | tath
model Rec {
  id       String   @id @default(cuid())
  userId   String
  lessonId String?
  halqaId  String?
  date     String
  type     String
  surah    Int
  fromA    Int
  toA      Int
  mistakes Int      @default(0)
  alerts   Int      @default(0)
  grade    String
  pass     Boolean
  note     String   @default("")
  /// مدة التسميع بالثواني
  secs     Int?
  /// سمّع السورة كاملة
  full     Boolean  @default(false)
  /// تقييم سريع بدون عدّ أخطاء
  quick    Boolean  @default(false)
  byId     String?
  at       DateTime @default(now())

  @@index([userId, date])
}

model Setting {
  key   String @id
  value Json
}

/// سجل العمليات وتغييرات الخطط
model AuditLog {
  id       String   @id @default(cuid())
  at       DateTime @default(now())
  byId     String?
  byName   String   @default("")
  action   String
  targetId String?
  text     String   @default("")
  detail   Json?

  @@index([targetId, at])
  @@index([at])
}

/// إعلانات الحلقات (halqaId فارغ = لكل الحلقات)
model Ann {
  id      String   @id @default(cuid())
  halqaId String?
  title   String
  body    String   @default("")
  byId    String?
  byName  String   @default("")
  at      DateTime @default(now())
}

model AnnRead {
  id     String   @id @default(cuid())
  annId  String
  userId String
  at     DateTime @default(now())

  @@unique([annId, userId])
}

/// الورد اليومي ومهام اليوم للطالب
model Wird {
  id     String   @id @default(cuid())
  userId String
  date   String
  items  Json     @default("[]")
  read   Int      @default(0)
  note   String   @default("")
  at     DateTime @default(now())

  @@unique([userId, date])
}

/// غرفة المعلمين
model Msg {
  id     String   @id @default(cuid())
  byId   String
  byName String
  text   String
  at     DateTime @default(now())

  @@index([at])
}

/// اشتراكات الإشعارات
model PushSub {
  id       String   @id @default(cuid())
  userId   String
  endpoint String   @unique
  keys     Json
  at       DateTime @default(now())

  @@index([userId])
}

/// النسخ الاحتياطية الأسبوعية
model Backup {
  id   String   @id @default(cuid())
  at   DateTime @default(now())
  size Int      @default(0)
  data Json
}

/// طابور رسائل الواتساب التلقائية (الواتس الذكي أو أي مزوّد)
model OutMsg {
  id        String    @id @default(cuid())
  key       String    @unique
  kind      String
  userId    String?
  lessonId  String?
  toPhone   String
  text      String
  status    String    @default("pending")
  sendAfter DateTime
  tries     Int       @default(0)
  resp      String    @default("")
  at        DateTime  @default(now())
  sentAt    DateTime?

  @@index([status, sendAfter])
}

/// رسائل بين الطالب (وولي أمره) ومعلم الحلقة. kind: msg | note (ملاحظة لليوم مثل: تعبان)
model Dm {
  id        String    @id @default(cuid())
  studentId String
  byId      String
  byName    String    @default("")
  fromStaff Boolean   @default(false)
  kind      String    @default("msg")
  date      String    @default("")
  text      String
  at        DateTime  @default(now())
  readAt    DateTime?

  @@index([studentId, at])
}

/// سجل السلوك. kind: good | bad
model Behav {
  id      String   @id @default(cuid())
  userId  String
  byId    String
  byName  String   @default("")
  kind    String   @default("good")
  text    String
  visible Boolean  @default(true)
  at      DateTime @default(now())

  @@index([userId, at])
}

/// تصويت سريع للطلاب وأولياء الأمور (halqaId فارغ = لكل الحلقات)
model Poll {
  id       String   @id @default(cuid())
  halqaId  String?
  question String
  options  Json     @default("[]")
  multi    Boolean  @default(false)
  closed   Boolean  @default(false)
  byId     String?
  byName   String   @default("")
  at       DateTime @default(now())
}

model PollVote {
  id     String   @id @default(cuid())
  pollId String
  userId String
  choice Json     @default("[]")
  at     DateTime @default(now())

  @@unique([pollId, userId])
}

/// حضور المعلم للجامع (مرة باليوم) مع المسافة عن موقع الجامع
model TeacherIn {
  id     String   @id @default(cuid())
  userId String
  date   String
  at     DateTime @default(now())
  lat    Float?
  lng    Float?
  dist   Int?
  acc    Int?
  branch String   @default("")
  /// ما فيه موقع محدد للجامع وقت التسجيل
  noLoc  Boolean  @default(false)

  @@unique([userId, date])
}

/// حركات النقاط اليدوية والمتجر (النقاط التلقائية تنحسب من الحضور والتسميع)
model PointTx {
  id     String   @id @default(cuid())
  userId String
  amount Int
  /// manual يدوي، spend شراء، refund استرجاع، auction مزاد
  kind   String
  reason String   @default("")
  byId   String?
  byName String   @default("")
  ref    String?
  at     DateTime @default(now())

  @@index([userId])
}

/// جوائز المتجر: item جائزة عادية، group جائزة للحلقة كاملة، auction مزاد
model Reward {
  id        String    @id @default(cuid())
  name      String
  note      String    @default("")
  kind      String    @default("item")
  price     Int       @default(0)
  /// تكلفتها بالريال (للميزانية)
  cost      Float     @default(0)
  /// الكمية (فارغ = بدون حد)
  stock     Int?
  branch    String    @default("")
  salePrice Int?
  saleUntil String?
  /// نهاية المزاد
  endsAt    DateTime?
  /// هدف نقاط الحلقة للجائزة الجماعية
  target    Int?
  halqaId   String?
  winnerId  String?
  closed    Boolean   @default(false)
  active    Boolean   @default(true)
  at        DateTime  @default(now())
}

model RewardOrder {
  id       String    @id @default(cuid())
  rewardId String
  userId   String
  price    Int
  code     String
  /// pending بانتظار التسليم، delivered تم، rejected مرفوض، cancelled ألغاه الطالب
  status   String    @default("pending")
  byId     String?
  byName   String    @default("")
  at       DateTime  @default(now())
  doneAt   DateTime?
  doneBy   String?

  @@index([userId])
}

model Bid {
  id       String   @id @default(cuid())
  rewardId String
  userId   String
  amount   Int
  at       DateTime @default(now())

  @@unique([rewardId, userId])
}
